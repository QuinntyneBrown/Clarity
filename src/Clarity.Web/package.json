{
  "name": "clarity-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "ng build @api && ng build @components",
    "start": "ng serve clarity",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "watch:api": "ng build @api --watch",
    "watch:components": "ng build @components --watch",
    "watch:libs": "npm-run-all --parallel watch:api watch:components",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "smoke": "npx playwright test e2e/tests/smoke-local.spec.ts",
    "smoke:azure": "npx playwright test e2e/tests/smoke-azure.spec.ts",
    "start:admin": "ng serve clarity-admin --port 4202",
    "build:admin": "ng build clarity-admin",
    "e2e:admin": "npx playwright test --config=playwright-admin.config.ts",
    "e2e:admin:headed": "npx playwright test --config=playwright-admin.config.ts --headed",
    "e2e:deployed": "npx playwright test --config=playwright-deployed.config.ts",
    "e2e:deployed:headed": "npx playwright test --config=playwright-deployed.config.ts --headed"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.18",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.18",
    "@angular/forms": "^19.2.18",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@angular/router": "^19.2.18",
    "@ngrx/component": "^19.2.1",
    "@ngrx/component-store": "^19.2.1",
    "@ngrx/operators": "^19.2.1",
    "npm-run-all": "^4.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular-devkit/build-angular": "^19.2.20",
    "@angular/cli": "~19.2.20",
    "@angular/compiler-cli": "^19.2.18",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "jasmine-core": "~4.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ng-packagr": "^19.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "~5.8.3"
  }
}
